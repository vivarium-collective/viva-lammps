{"id": "pbg_lammps.composites.lj-box-model", "name": "lj-box-model", "description": "Model-plugin seam demo: the general `LammpsModelProcess` driving the registered `lj-box` LennardJonesBox plugin. Same tiny LJ NVE box as lj-nve-demo, but built through the model seam instead of a hand-written input script. Emits temperature and the three energies each step.", "parameters": {"interval": {"type": "float", "default": 0.5, "description": "Process interval in LJ time units. The process issues `run N` calls sized to fit this window."}, "lattice_size": {"type": "integer", "default": 3, "description": "Lattice replications per side; the box holds lattice_size**3 atoms."}, "lattice_density": {"type": "float", "default": 0.5, "description": "Reduced density of the simple-cubic lattice used to seed atoms."}, "initial_temperature": {"type": "float", "default": 1.0, "description": "Reduced temperature for initial Maxwell-Boltzmann sampling."}}, "state": {"lammps": {"_type": "process", "address": "local:LammpsModelProcess", "config": {"model": "lj-box", "params": {"n": 3, "density": 0.5, "temperature": 1.0}}, "inputs": {}, "outputs": {"temperature": ["stores", "temperature"], "potential_energy": ["stores", "potential_energy"], "kinetic_energy": ["stores", "kinetic_energy"], "total_energy": ["stores", "total_energy"], "num_atoms": ["stores", "num_atoms"]}, "interval": 0.5, "interval_label": "0.5 s"}, "stores": {"temperature": 0.0, "potential_energy": 0.0, "kinetic_energy": 0.0, "total_energy": 0.0, "num_atoms": 0}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"temperature": "float", "potential_energy": "float", "kinetic_energy": "float", "total_energy": "float"}}, "inputs": {"temperature": ["stores", "temperature"], "potential_energy": ["stores", "potential_energy"], "kinetic_energy": ["stores", "kinetic_energy"], "total_energy": ["stores", "total_energy"]}}, "_declared_emit_paths": ["stores/temperature", "stores/potential_energy", "stores/kinetic_energy", "stores/total_energy"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["LammpsModelProcess", "RAMEmitter"]}, "tags": ["lammps", "molecular-dynamics", "demo", "model-seam"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}