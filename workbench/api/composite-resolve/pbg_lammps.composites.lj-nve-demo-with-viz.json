{"id": "pbg_lammps.composites.lj-nve-demo-with-viz", "name": "lj-nve-demo-with-viz", "description": "LAMMPS LJ NVE demo with a wired Visualization Step. Each update produces a Plotly HTML figure of the running thermodynamic trajectories, written to the 'viz_html' store.", "parameters": {"interval": {"type": "float", "default": 0.5, "description": "Process interval in LJ time units."}, "lattice_density": {"type": "float", "default": 0.5, "description": "Reduced density of the simple-cubic lattice used to seed atoms."}, "initial_temperature": {"type": "float", "default": 1.0, "description": "Reduced temperature used by `velocity all create`."}, "viz_title": {"type": "string", "default": "LAMMPS LJ NVE thermodynamics", "description": "Title displayed at the top of the Plotly figure."}}, "state": {"lammps": {"_type": "process", "address": "local:LAMMPSProcess", "config": {"input_script": "units lj\natom_style atomic\ndimension 3\nboundary p p p\nlattice sc 0.5\nregion box block 0 3 0 3 0 3\ncreate_box 1 box\ncreate_atoms 1 box\nmass 1 1.0\npair_style lj/cut 2.5\npair_coeff 1 1 1.0 1.0\npair_modify shift yes\nvelocity all create 1.0 87287 dist gaussian\ntimestep 0.005\nfix integ all nve\n"}, "inputs": {}, "outputs": {"temperature": ["stores", "temperature"], "potential_energy": ["stores", "potential_energy"], "kinetic_energy": ["stores", "kinetic_energy"], "total_energy": ["stores", "total_energy"], "pressure": ["stores", "pressure"], "volume": ["stores", "volume"]}, "interval": 0.5, "interval_label": "0.5 s"}, "stores": {"temperature": 0.0, "potential_energy": 0.0, "kinetic_energy": 0.0, "total_energy": 0.0, "pressure": 0.0, "volume": 0.0, "viz_html": ""}, "viz": {"_type": "step", "address": "local:LAMMPSThermoPlots", "config": {"title": "LAMMPS LJ NVE thermodynamics"}, "inputs": {"temperature": ["stores", "temperature"], "potential_energy": ["stores", "potential_energy"], "kinetic_energy": ["stores", "kinetic_energy"], "total_energy": ["stores", "total_energy"], "pressure": ["stores", "pressure"], "time": ["global_time"]}, "outputs": {"html": ["stores", "viz_html"]}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"temperature": "float", "potential_energy": "float", "kinetic_energy": "float", "total_energy": "float", "pressure": "float", "volume": "float"}}, "inputs": {"temperature": ["stores", "temperature"], "potential_energy": ["stores", "potential_energy"], "kinetic_energy": ["stores", "kinetic_energy"], "total_energy": ["stores", "total_energy"], "pressure": ["stores", "pressure"], "volume": ["stores", "volume"]}}, "_declared_emit_paths": ["stores/temperature", "stores/potential_energy", "stores/kinetic_energy", "stores/total_energy", "stores/pressure", "stores/volume"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["LAMMPSProcess", "LAMMPSThermoPlots", "RAMEmitter"]}, "tags": ["lammps", "molecular-dynamics", "demo", "visualization"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}